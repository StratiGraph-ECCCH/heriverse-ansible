{{ server_name }} {
    # Don't show ATON's frontend home page
    redir / /a/heriverse 302

    request_body {
        max_size 3GB # This can be made configurable
    }

    # `handle_path` is required where URIs must be rewritten
    handle_path /server/* {
        reverse_proxy localhost:3000
    }

    handle /auth* {
        reverse_proxy localhost:8080
    }

    handle_path /couchdb/* {
        reverse_proxy localhost:5984
    }

{% if em_server_enabled | default(false) %}
    # StratiGraph · the EM room: graph + assets, and the WebSocket the editors
    # join. Behind the proxy on purpose — it is also what stops the access token
    # from travelling in a URL a plain HTTP server would write to its log, since
    # a browser cannot set a header on a WebSocket handshake.
    handle_path /em/* {
        reverse_proxy em-server:8000
    }
{% endif %}
{% if em_catalog_enabled | default(false) %}
    # StratiGraph · the CATALOG: the studies as published, beside the rooms.
    # `handle` and NOT `handle_path`: em-catalog serves /catalog/... at its own
    # root, so the prefix IS part of the endpoint and stripping it would take
    # the route with it — the same distinction as /iiif below, and the same
    # trap. A study whose header says `visibility: public` is served here
    # WITHOUT a token; everything else needs one.
    handle /catalog/* {
        reverse_proxy em-catalog:8000
    }
{% endif %}
{% if iiif_enabled | default(false) %}
    # StratiGraph · the IIIF Image API. `handle` and NOT `handle_path`: the
    # version lives in the path (/iiif/3/...), so stripping the prefix would
    # take the endpoint with it. Public by default — an image service every
    # viewer can read is the point of adopting IIIF.
{% if iiif_embargo_gate | default(false) and em_server_enabled | default(false) %}
    #
    # EMBARGO GATE (on: `iiif_embargo_gate`). Cantaloupe reads the bucket by
    # sha256 and em-server is not in the path of a pixel, so an embargoed image
    # is reachable by anybody who has the digest. With this, every image request
    # is authorised by em-server first: it reads the graph, resolves the room's
    # roles and applies the same rule the asset route applies — editor and above
    # may see an embargoed image while the embargo runs, nobody else may.
    #
    # OFF by default, and deliberately: turning it on puts em-server in the path
    # of every image request, which is a latency and an availability decision an
    # operator makes, not one a template makes for them. Off = today's
    # behaviour, exactly.
    handle /iiif/* {
        forward_auth em-server:{{ em_server_port | default(8000) }} {
            uri /v1/iiif-authz
            copy_headers X-EM-Authz
        }
        reverse_proxy cantaloupe:{{ cantaloupe_port }}
    }
{% else %}
    handle /iiif/* {
        reverse_proxy cantaloupe:{{ cantaloupe_port }}
    }
{% endif %}
{% endif %}
{% if minio_enabled | default(false) %}
    # The object store's own API. Published for clients that fetch an asset
    # directly by its digest; em-server reaches it on the internal network.
    handle_path /assets/* {
        reverse_proxy minio:{{ minio_api_port }}
    }
{% endif %}

    handle /* {
        reverse_proxy localhost:8081
    }
}
