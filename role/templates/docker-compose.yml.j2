{#
  DRAFT — the StratiGraph service (StratiGraph Server + MinIO) added to the Heriverse
  stack. Five things to agree with 3DR before this is merged:

    1. the StratiGraph Server image name/registry (here: stratigraph/stratigraph-server:latest) and
       who builds it — the Dockerfile lives in the StratiGraph Server repo;
    2. the Keycloak client for em-server (audience `em_server_audience`) in the
       existing realm: StratiGraph Server VALIDATES tokens, it never logs anybody in;
    3. whether MinIO is the shared object store for the whole stack or only for
       EM assets (Heriverse's uploads are on a host volume today). StratiGraph Server
       writes to it through the same implementation the dev stack exercises
       (stratigraph-server/dev-stack), so this wiring is live, not aspirational;
    4. the reverse-proxy convention: the routes below address services by their
       COMPOSE NAME (stratigraph-server:8000), which is what works on the `backend`
       bridge network; the existing routes use `localhost:PORT`, which only
       works if caddy runs with host networking. One of the two is wrong for
       this file and it should be the same everywhere;
    5. backups: `em_data` holds the room documents — it is study data, not cache.
#}
services:
  caddy:
    image: caddy:latest
    ports:
      - "443:443"
    volumes:
      - ./mount/caddy/Caddyfile:/etc/caddy/Caddyfile
      - ./mount/certs:/certs
      - ./mount/caddy/caddy_boot.sh:/caddy_boot.sh:ro
{% if em_studio_dist | default('') %}
      # EMStudio's built `dist/`, served by Caddy at /em/studio/ and /em/read/.
      # Read-only, and a bind rather than a named volume — the same reasoning as
      # the reader mount on em-catalog below: it is an artefact somebody built
      # and put on this host, not state this stack owns. Replacing it is `rsync`
      # plus nothing; Caddy stats the files per request.
      #
      # The path is the SAME on both sides so the Caddyfile can name it once
      # ({{ em_studio_dist }}) and mean the same thing in the template and in the
      # container.
      - "{{ em_studio_dist }}:{{ em_studio_dist }}:ro"
{% endif %}
    depends_on:
      - heriverse
      - heriverse-server
      - keycloak  
    networks:
      - backend
    restart: always

  # =======================
  # FRONTEND
  # =======================
  heriverse:
    image: git.3dresearch.it:5050/cnr-h2iosc/heriverse/heriverse-wapp:latest
    container_name: heriverse
    ports:
      - "8081:8080"
    depends_on:
      - heriverse-server
      - keycloak
    volumes:
      - ./mount/heriverse/config/Utils.js:/aton/wapps/heriverse/config/Utils.js
    networks:
      - backend
    restart: always

  # =======================
  # BACKEND / API SERVER
  # =======================
  heriverse-server:
    image: git.3dresearch.it:5050/stratigraph/heriverse-server:latest
    container_name: heriverse-server
    ports:
      - "3000:3000"
    depends_on:
      - couchdb
      - keycloak
    volumes:
      - ./mount/server/uploads:/app/uploads
      - ./mount/server/config:/app/conf
    networks:
      - backend
    restart: always
  # =======================
  # DATABASE
  # =======================
  couchdb:
    image: apache/couchdb:3
    container_name: couchdb
    environment:
      - COUCHDB_USER=admin
      - COUCHDB_PASSWORD=admin
      - COUCHDB_SECRET=heriversesecret
      - COUCHDB_SINGLE_NODE=true
    ports:
      - "5984:5984"
    volumes:
      - couchdb_data:/opt/couchdb/data
      - couchdb_config:/opt/couchdb/etc/local.d
    networks:
      - backend
    restart: always
  keycloak:
    image: quay.io/keycloak/keycloak:24.0.4
    container_name: keycloak
    environment:
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: admin
      KC_DB: dev-file
      KC_PROXY: edge
      KC_HTTP_ENABLED: "true"
      KC_HOSTNAME_STRICT: "false"
      KC_HOSTNAME_STRICT_HTTPS: "false"
    ports:
      - "8080:8080"
    command:
      - start
      - --import-realm
      - --http-relative-path=/auth
      - --proxy-headers=xforwarded
      - --hostname={{ server_name }}
      - --hostname-strict=false
      - --hostname-strict-https=false
      - --http-enabled=true
    volumes:
      - keycloak_data:/opt/keycloak/data
      - ./mount/keycloak/realms/realm-heriverse.json:/opt/keycloak/data/import/realm-heriverse.json
    networks:
      - backend
    restart: always
{% if em_server_enabled | default(false) %}
  # =======================
  # STRATIGRAPH · StratiGraph Server (the ROOM: a project's graph + its assets)
  # =======================
  stratigraph-server:
    image: {{ em_server_image }}
    container_name: stratigraph-server
    environment:
      # A resource server against the realm this stack already runs: same
      # users, same revocations, no session store on either side.
      TOKEN_ENDPOINT: "{{ em_server_token_endpoint }}"
      OIDC_AUDIENCE: "{{ em_server_audience }}"
{% if nodeodm_enabled | default(false) %}
      # the photogrammetric engine, by service name on the backend network.
      # Unset when the engine is off: /v1/photogrammetry then answers 503 saying
      # so, which is a fact about this deployment and not a failure.
      NODEODM_URL: "{{ nodeodm_url }}"
{% endif %}
      # Where a room's document is written. Set explicitly: with nothing set
      # StratiGraph Server keeps rooms in memory, which is honest on a laptop and wrong
      # here — and /v1/health says which one is in use.
      EM_SNAPSHOT_DIR: "{{ em_server_snapshot_dir }}"
{% if iiif_enabled | default(false) %}
      # --- the URL topology (stratigraph-server/docs/URL-TOPOLOGY.md) ------------------
      # PUBLIC: what StratiGraph Server WRITES into the manifests other people's viewers
      # fetch. INTERNAL: how StratiGraph Server DIALS the image server to read info.json.
      # They are two settings because they are two addresses; collapsing them is
      # what makes every canvas silently get a placeholder size.
      EM_IIIF_PUBLIC: "https://{{ server_name }}/iiif/3"
      EM_IIIF_INTERNAL: "http://cantaloupe:{{ cantaloupe_port }}/iiif/3"
{% endif %}
{% if minio_enabled | default(false) %}
      # The asset store: the object store below. Assets are content-addressed
      # (the object's name IS the sha256 of its bytes), so dedup is free and any
      # client can verify what it fetched. All four settings or none — StratiGraph Server
      # refuses to start on a half-configured store rather than falling back to
      # a local directory nobody backs up.
      EM_ASSET_S3_ENDPOINT: "http://minio:{{ minio_api_port }}"
      EM_ASSET_S3_BUCKET: "{{ minio_bucket }}"
      EM_ASSET_S3_ACCESS_KEY: "{{ minio_root_user }}"
      EM_ASSET_S3_SECRET_KEY: "{{ minio_root_password }}"
{% else %}
      # No object store configured: the assets go on the volume below. Honest
      # for a single instance, wrong for replicas — /v1/health says which it is.
      EM_ASSET_DIR: "{{ em_server_asset_dir }}"
{% endif %}
    ports:
      - "{{ em_server_port }}:8000"
    depends_on:
      - keycloak
{% if minio_enabled | default(false) %}
      - minio
{% endif %}
    volumes:
      - em_data:/srv/em-data
    networks:
      - backend
    restart: always
{% endif %}
{% if em_catalog_enabled | default(false) %}

  # =======================
  # STRATIGRAPH · StratiGraph Catalog (the REGISTER: studies as published)
  # =======================
  # A separate service from StratiGraph Server on purpose. StratiGraph Server serves the ROOM (the
  # graph being edited right now); this serves the STUDY (the container as
  # published). They share the object store — one bucket, two prefixes — and the
  # same realm, which is what makes "the study you catalogue is the study you
  # edit" true in the configuration and not only in the prose.
  #
  # A study IS an em.json container and the container is the truth; the index
  # below is a PROJECTION of the containers, rebuildable with one
  # `POST /catalog/reindex`. That is why losing the index is an inconvenience
  # and losing the bucket is a disaster — back up the bucket.
  stratigraph-catalog:
    image: {{ em_catalog_image }}
    container_name: stratigraph-catalog
    environment:
      # The same realm StratiGraph Server validates against: one identity, two services.
      TOKEN_ENDPOINT: "{{ em_server_token_endpoint }}"
      OIDC_AUDIENCE: "{{ em_catalog_audience }}"
{% if minio_enabled | default(false) %}
      # The studies themselves. The SAME bucket as the assets, under the
      # `studies/` prefix — one store to provision, one store to back up. All
      # four settings or none: StratiGraph Catalog refuses to start on a half-configured
      # store rather than keeping studies in a process that dies.
      MINIO_ENDPOINT: "http://minio:{{ minio_api_port }}"
      MINIO_BUCKET: "{{ minio_bucket }}"
      MINIO_ACCESS_KEY: "{{ minio_root_user }}"
      MINIO_SECRET_KEY: "{{ minio_root_password }}"
{% endif %}
{% if em_catalog_couchdb_enabled | default(false) %}
      # The DEPLOY index: this stack's CouchDB, with a database of its own. The
      # documents carry `type: "study"` and sit beside Heriverse's `scene` ones.
      COUCHDB_URL: "http://couchdb:5984"
      COUCHDB_DATABASE: "{{ em_catalog_couchdb_database }}"
      COUCHDB_USER: "{{ couchdb_user }}"
      COUCHDB_PASSWORD: "{{ couchdb_password }}"
{% else %}
      # No CouchDB configured: the dev index (SQLite) on the volume below. It is
      # derived, so this is a performance and operations choice, not a safety
      # one — but /health says which one is answering.
      EM_CATALOG_DB: "{{ em_catalog_db_path }}"
{% endif %}
      # PUBLIC forms, as everywhere: what goes into an answer somebody else's
      # software will fetch. StratiGraph Catalog never dials either of them.
      #
      # `EM_CATALOG_PUBLIC_URL` is GONE, and its absence is the correction. It
      # said `https://{{ server_name }}` — which is RIGHT here, unlike the dev
      # stack where the same variable said `http://localhost:8010` and every
      # container link it wrote was blocked as mixed content. But right or wrong
      # it was a SECOND copy of a fact the request already carries, and the copy
      # is the thing that can drift: rename the host, or put the service behind a
      # second name, and the catalogue keeps handing out the old one.
      #
      # StratiGraph Catalog derives it from the request now
      # (`app/main.py::_public_base`), which is right by definition — and the two
      # flags that make that true are in its own Dockerfile
      # (`--proxy-headers --forwarded-allow-ips *`). Without them Starlette sees
      # the internal request and the derivation is wrong in a different way, so
      # THAT is the repair if a link ever comes out with an internal address —
      # not putting this variable back.
      #
      # It still exists as an override for a proxy that does not forward.
      EM_CATALOG_EMSTUDIO_URL: "{{ em_catalog_emstudio_url }}"
{% if em_catalog_reader_dist | default('') %}
      # The reading page: EMStudio's built reader, served as a DIRECTORY under
      # /catalog/reader/ (shell plus assets — it is no longer one file). Unset
      # → `/catalog/study/{id}/narrative` answers an honest 501 naming the build
      # command, which is better than a blank page that reads as an empty study.
      EM_CATALOG_READER: "/srv/em-reader-dist"
{% endif %}
    ports:
      - "{{ em_catalog_port }}:8000"
    depends_on:
      - keycloak
{% if minio_enabled | default(false) %}
      - minio
{% endif %}
{% if em_catalog_couchdb_enabled | default(false) %}
      - couchdb
{% endif %}
    volumes:
      - em_catalog_data:/srv/em-catalog-data
{% if em_catalog_reader_dist | default('') %}
      # Read-only, and a bind rather than a named volume: the reader is an
      # artefact somebody built and put on this host, not state this stack owns.
      # Replacing it is `rsync` plus nothing — StratiGraph Catalog stats the files per
      # request, so a new build is served without a restart.
      - "{{ em_catalog_reader_dist }}:/srv/em-reader-dist:ro"
{% endif %}
    networks:
      - backend
    restart: always
{% endif %}
{% if iiif_enabled | default(false) and minio_enabled | default(false) %}

  # =======================
  # IIIF IMAGE API (Cantaloupe) — reads the asset bucket directly
  # =======================
  # The identifier IS the asset's sha256, which is the object's key: one name
  # for one thing, and no import step. Exercised in stratigraph-server/dev-stack, which
  # runs this same image against this same source configuration.
  cantaloupe:
    image: {{ cantaloupe_image }}
    container_name: cantaloupe
    depends_on:
      - minio
    environment:
      CANTALOUPE_HTTP_ENABLED: "true"
      CANTALOUPE_HTTP_HOST: "0.0.0.0"
      CANTALOUPE_HTTP_PORT: "8182"
      CANTALOUPE_HTTPS_ENABLED: "false"
      CANTALOUPE_ENDPOINT_IIIF_3_ENABLED: "true"
      CANTALOUPE_ENDPOINT_IIIF_2_ENABLED: "true"
      CANTALOUPE_ENDPOINT_ADMIN_ENABLED: "false"
      CANTALOUPE_ENDPOINT_API_ENABLED: "false"
      CANTALOUPE_ENDPOINT_HEALTH_ENABLED: "true"
      # behind the proxy: the ids in info.json must be the PUBLIC urls, or every
      # viewer that follows them lands on a host it cannot reach
      CANTALOUPE_BASE_URI: "https://{{ server_name }}/iiif"
      CANTALOUPE_SOURCE_STATIC: "S3Source"
      CANTALOUPE_S3SOURCE_ENDPOINT: "http://minio:{{ minio_api_port }}"
      CANTALOUPE_S3SOURCE_ACCESS_KEY_ID: "{{ minio_root_user }}"
      CANTALOUPE_S3SOURCE_SECRET_KEY: "{{ minio_root_password }}"
      CANTALOUPE_S3SOURCE_REGION: "us-east-1"
      CANTALOUPE_S3SOURCE_LOOKUP_STRATEGY: "BasicLookupStrategy"
      CANTALOUPE_S3SOURCE_BASICLOOKUPSTRATEGY_BUCKET_NAME: "{{ minio_bucket }}"
      CANTALOUPE_S3SOURCE_BASICLOOKUPSTRATEGY_PATH_PREFIX: ""
      CANTALOUPE_S3SOURCE_BASICLOOKUPSTRATEGY_PATH_SUFFIX: ""
      CANTALOUPE_PROCESSOR_SELECTION_STRATEGY: "AutomaticSelectionStrategy"
      # A derivative cache belongs here (it is pure speed), but it must be
      # VERIFIED before it is switched on: with the filesystem cache enabled the
      # dev stack measured 200 responses with zero-byte bodies. Left off, with
      # the reason, rather than on and untested.
      CANTALOUPE_CACHE_SERVER_DERIVATIVE_ENABLED: "false"
    networks:
      - backend
    restart: always
{% endif %}
{% if em_chatbot_enabled | default(false) %}

  # =======================
  # THE FIELD ASSISTANT — the voice in the trench, and why it needs an ORIGIN
  #
  # A PWA, so what it wants from this deployment is not a runtime but a secure
  # context: a browser gives camera, microphone and GPS only over https, which on
  # a phone means it is useless anywhere except behind this stack's Caddy. That
  # is why it is a service here and not something somebody runs by hand.
  #
  # No published port: it is reached at `/chat/` through the proxy, like the
  # catalogue. The port in the defaults exists for an operator debugging it on
  # the host, and is deliberately not mapped.
  # =======================
  stratigraph-chatbot:
    image: {{ em_chatbot_image }}
    container_name: stratigraph-chatbot
    environment:
      # Where what was said ends up when no room is configured — see below.
      EM_CHATBOT_CONTAINER: "{{ em_chatbot_container }}"
      EM_CHATBOT_STUDY: "{{ em_chatbot_study }}"
{% if minio_enabled | default(false) %}
      # The photographs. The SAME bucket and the SAME variables the room server
      # reads — reused rather than paralleled, because two spellings of one
      # bucket is how one of them ends up pointing somewhere else.
      MINIO_ENDPOINT: "http://minio:{{ minio_api_port }}"
      MINIO_BUCKET: "{{ minio_bucket }}"
      MINIO_ACCESS_KEY: "{{ minio_root_user }}"
      MINIO_SECRET_KEY: "{{ minio_root_password }}"
{% endif %}
{% if em_chatbot_room | default('') %}
      # A ROOM, chosen explicitly by the operator (see the defaults): what is said
      # appears live in EMStudio. The token comes from Vault and never from a
      # file in the repo — the service refuses to start with a room and no token,
      # which is the right refusal and the reason this block is conditional.
      EM_SERVER_URL: "{{ em_chatbot_server_url }}"
      EM_CHATBOT_ROOM: "{{ em_chatbot_room }}"
      EM_CHATBOT_TOKEN: "{{ em_chatbot_token }}"
{% endif %}
    depends_on:
{% if minio_enabled | default(false) %}
      - minio
{% endif %}
{% if em_chatbot_room | default('') %}
      - stratigraph-server
{% endif %}
    volumes:
      # DATA. What a field session recorded, on a machine that is switched off by
      # pulling the plug.
      - chatbot_data:/srv/chatbot-data
    networks:
      - backend
    restart: always
{% endif %}
{% if nodeodm_enabled | default(false) %}

  # =======================
  # PHOTOGRAMMETRY ENGINE (NodeODM) — a cluster of photographs becomes a model
  #
  # A PULLED DEPENDENCY, pinned. StratiGraph Server drives it over three REST
  # endpoints (task/new, task/{uuid}/info, download/all.zip); everything the act
  # MEANS — the genesis event, the control set, the placement — is s3Dgraphy's.
  #
  # No ports: published nowhere, on the backend network only. The engine has no
  # authentication of its own, so exposing it would be handing anybody on the
  # internet a CPU. StratiGraph Server reaches it by service name.
  # =======================
  nodeodm:
    image: {{ nodeodm_image }}
    container_name: nodeodm
    volumes:
      # the engine's working area: tasks and the archives it still serves back.
      # Named, so a restart does not lose a run somebody has not collected.
      - nodeodm_data:/var/www/data
    networks:
      - backend
    restart: always
{% endif %}
{% if minio_enabled | default(false) %}

  # =======================
  # OBJECT STORE (assets: models, orthophotos — referenced, not embedded)
  # =======================
  minio:
    image: {{ minio_image }}
    container_name: minio
    command: server /data --console-address ":{{ minio_console_port }}"
    environment:
      # From the inventory / Vault. The template FAILS here if they are not
      # provided, which is the intended behaviour: a default password would be
      # the same password on every deployment.
      MINIO_ROOT_USER: "{{ minio_root_user }}"
      MINIO_ROOT_PASSWORD: "{{ minio_root_password }}"
    ports:
      - "{{ minio_api_port }}:9000"
      - "{{ minio_console_port }}:{{ minio_console_port }}"
    volumes:
      - minio_data:/data
    networks:
      - backend
    restart: always
{% endif %}
# =======================
# NETWORK AND VOLUMES
# =======================
networks:
  backend:
    driver: bridge

volumes:
  couchdb_data:
  couchdb_config:
  keycloak_data:
{% if em_server_enabled | default(false) %}
  em_data:      # room documents — study data, include it in the backups
{% endif %}
{% if em_catalog_enabled | default(false) %}
{% if nodeodm_enabled | default(false) %}
  nodeodm_data:      # the engine's tasks — recomputable, but a run in flight is not
{% endif %}
{% if em_chatbot_enabled | default(false) %}
  chatbot_data:      # DATA: what the field assistant recorded. Back this up —
                     # a dictated unit exists nowhere else until it reaches a room.
{% endif %}
  em_catalog_data:   # the SQLite index when CouchDB is off — DERIVED, so losing
                     # it costs one POST /catalog/reindex, not a study
{% endif %}
{% if minio_enabled | default(false) %}
  minio_data:   # the assets themselves, addressed by their own digest
{% endif %}
