{#
  DRAFT — the StratiGraph service (em-server + MinIO) added to the Heriverse
  stack. Five things to agree with 3DR before this is merged:

    1. the em-server image name/registry (here: stratigraph/em-server:latest) and
       who builds it — the Dockerfile lives in the em-server repo;
    2. the Keycloak client for em-server (audience `em_server_audience`) in the
       existing realm: em-server VALIDATES tokens, it never logs anybody in;
    3. whether MinIO is the shared object store for the whole stack or only for
       EM assets (Heriverse's uploads are on a host volume today). em-server
       writes to it through the same implementation the dev stack exercises
       (em-server/dev-stack), so this wiring is live, not aspirational;
    4. the reverse-proxy convention: the routes below address services by their
       COMPOSE NAME (em-server:8000), which is what works on the `backend`
       bridge network; the existing routes use `localhost:PORT`, which only
       works if caddy runs with host networking. One of the two is wrong for
       this file and it should be the same everywhere;
    5. backups: `em_data` holds the room documents — it is study data, not cache.
#}
services:
  caddy:
    image: caddy:latest
    ports:
      - "443:443"
    volumes:
      - ./mount/caddy/Caddyfile:/etc/caddy/Caddyfile
      - ./mount/certs:/certs
      - ./mount/caddy/caddy_boot.sh:/caddy_boot.sh:ro
    depends_on:
      - heriverse
      - heriverse-server
      - keycloak  
    networks:
      - backend
    restart: always

  # =======================
  # FRONTEND
  # =======================
  heriverse:
    image: git.3dresearch.it:5050/cnr-h2iosc/heriverse/heriverse-wapp:latest
    container_name: heriverse
    ports:
      - "8081:8080"
    depends_on:
      - heriverse-server
      - keycloak
    volumes:
      - ./mount/heriverse/config/Utils.js:/aton/wapps/heriverse/config/Utils.js
    networks:
      - backend
    restart: always

  # =======================
  # BACKEND / API SERVER
  # =======================
  heriverse-server:
    image: git.3dresearch.it:5050/stratigraph/heriverse-server:latest
    container_name: heriverse-server
    ports:
      - "3000:3000"
    depends_on:
      - couchdb
      - keycloak
    volumes:
      - ./mount/server/uploads:/app/uploads
      - ./mount/server/config:/app/conf
    networks:
      - backend
    restart: always
  # =======================
  # DATABASE
  # =======================
  couchdb:
    image: apache/couchdb:3
    container_name: couchdb
    environment:
      - COUCHDB_USER=admin
      - COUCHDB_PASSWORD=admin
      - COUCHDB_SECRET=heriversesecret
      - COUCHDB_SINGLE_NODE=true
    ports:
      - "5984:5984"
    volumes:
      - couchdb_data:/opt/couchdb/data
      - couchdb_config:/opt/couchdb/etc/local.d
    networks:
      - backend
    restart: always
  keycloak:
    image: quay.io/keycloak/keycloak:24.0.4
    container_name: keycloak
    environment:
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: admin
      KC_DB: dev-file
      KC_PROXY: edge
      KC_HTTP_ENABLED: "true"
      KC_HOSTNAME_STRICT: "false"
      KC_HOSTNAME_STRICT_HTTPS: "false"
    ports:
      - "8080:8080"
    command:
      - start
      - --import-realm
      - --http-relative-path=/auth
      - --proxy-headers=xforwarded
      - --hostname={{ server_name }}
      - --hostname-strict=false
      - --hostname-strict-https=false
      - --http-enabled=true
    volumes:
      - keycloak_data:/opt/keycloak/data
      - ./mount/keycloak/realms/realm-heriverse.json:/opt/keycloak/data/import/realm-heriverse.json
    networks:
      - backend
    restart: always
{% if em_server_enabled | default(false) %}
  # =======================
  # STRATIGRAPH · em-server (the ROOM: a project's graph + its assets)
  # =======================
  em-server:
    image: {{ em_server_image }}
    container_name: em-server
    environment:
      # A resource server against the realm this stack already runs: same
      # users, same revocations, no session store on either side.
      TOKEN_ENDPOINT: "{{ em_server_token_endpoint }}"
      OIDC_AUDIENCE: "{{ em_server_audience }}"
      # Where a room's document is written. Set explicitly: with nothing set
      # em-server keeps rooms in memory, which is honest on a laptop and wrong
      # here — and /v1/health says which one is in use.
      EM_SNAPSHOT_DIR: "{{ em_server_snapshot_dir }}"
{% if iiif_enabled | default(false) %}
      # --- the URL topology (em-server/docs/URL-TOPOLOGY.md) ------------------
      # PUBLIC: what em-server WRITES into the manifests other people's viewers
      # fetch. INTERNAL: how em-server DIALS the image server to read info.json.
      # They are two settings because they are two addresses; collapsing them is
      # what makes every canvas silently get a placeholder size.
      EM_IIIF_PUBLIC: "https://{{ server_name }}/iiif/3"
      EM_IIIF_INTERNAL: "http://cantaloupe:{{ cantaloupe_port }}/iiif/3"
{% endif %}
{% if minio_enabled | default(false) %}
      # The asset store: the object store below. Assets are content-addressed
      # (the object's name IS the sha256 of its bytes), so dedup is free and any
      # client can verify what it fetched. All four settings or none — em-server
      # refuses to start on a half-configured store rather than falling back to
      # a local directory nobody backs up.
      EM_ASSET_S3_ENDPOINT: "http://minio:{{ minio_api_port }}"
      EM_ASSET_S3_BUCKET: "{{ minio_bucket }}"
      EM_ASSET_S3_ACCESS_KEY: "{{ minio_root_user }}"
      EM_ASSET_S3_SECRET_KEY: "{{ minio_root_password }}"
{% else %}
      # No object store configured: the assets go on the volume below. Honest
      # for a single instance, wrong for replicas — /v1/health says which it is.
      EM_ASSET_DIR: "{{ em_server_asset_dir }}"
{% endif %}
    ports:
      - "{{ em_server_port }}:8000"
    depends_on:
      - keycloak
{% if minio_enabled | default(false) %}
      - minio
{% endif %}
    volumes:
      - em_data:/srv/em-data
    networks:
      - backend
    restart: always
{% endif %}
{% if em_catalog_enabled | default(false) %}

  # =======================
  # STRATIGRAPH · em-catalog (the REGISTER: studies as published)
  # =======================
  # A separate service from em-server on purpose. em-server serves the ROOM (the
  # graph being edited right now); this serves the STUDY (the container as
  # published). They share the object store — one bucket, two prefixes — and the
  # same realm, which is what makes "the study you catalogue is the study you
  # edit" true in the configuration and not only in the prose.
  #
  # A study IS an em.json container and the container is the truth; the index
  # below is a PROJECTION of the containers, rebuildable with one
  # `POST /catalog/reindex`. That is why losing the index is an inconvenience
  # and losing the bucket is a disaster — back up the bucket.
  em-catalog:
    image: {{ em_catalog_image }}
    container_name: em-catalog
    environment:
      # The same realm em-server validates against: one identity, two services.
      TOKEN_ENDPOINT: "{{ em_server_token_endpoint }}"
      OIDC_AUDIENCE: "{{ em_catalog_audience }}"
{% if minio_enabled | default(false) %}
      # The studies themselves. The SAME bucket as the assets, under the
      # `studies/` prefix — one store to provision, one store to back up. All
      # four settings or none: em-catalog refuses to start on a half-configured
      # store rather than keeping studies in a process that dies.
      MINIO_ENDPOINT: "http://minio:{{ minio_api_port }}"
      MINIO_BUCKET: "{{ minio_bucket }}"
      MINIO_ACCESS_KEY: "{{ minio_root_user }}"
      MINIO_SECRET_KEY: "{{ minio_root_password }}"
{% endif %}
{% if em_catalog_couchdb_enabled | default(false) %}
      # The DEPLOY index: this stack's CouchDB, with a database of its own. The
      # documents carry `type: "study"` and sit beside Heriverse's `scene` ones.
      COUCHDB_URL: "http://couchdb:5984"
      COUCHDB_DATABASE: "{{ em_catalog_couchdb_database }}"
      COUCHDB_USER: "{{ couchdb_user }}"
      COUCHDB_PASSWORD: "{{ couchdb_password }}"
{% else %}
      # No CouchDB configured: the dev index (SQLite) on the volume below. It is
      # derived, so this is a performance and operations choice, not a safety
      # one — but /health says which one is answering.
      EM_CATALOG_DB: "{{ em_catalog_db_path }}"
{% endif %}
      # PUBLIC forms, as everywhere: what goes into an answer somebody else's
      # software will fetch. em-catalog never dials either of them.
      EM_CATALOG_PUBLIC_URL: "https://{{ server_name }}"
      EM_CATALOG_EMSTUDIO_URL: "{{ em_catalog_emstudio_url }}"
    ports:
      - "{{ em_catalog_port }}:8000"
    depends_on:
      - keycloak
{% if minio_enabled | default(false) %}
      - minio
{% endif %}
{% if em_catalog_couchdb_enabled | default(false) %}
      - couchdb
{% endif %}
    volumes:
      - em_catalog_data:/srv/em-catalog-data
    networks:
      - backend
    restart: always
{% endif %}
{% if iiif_enabled | default(false) and minio_enabled | default(false) %}

  # =======================
  # IIIF IMAGE API (Cantaloupe) — reads the asset bucket directly
  # =======================
  # The identifier IS the asset's sha256, which is the object's key: one name
  # for one thing, and no import step. Exercised in em-server/dev-stack, which
  # runs this same image against this same source configuration.
  cantaloupe:
    image: {{ cantaloupe_image }}
    container_name: cantaloupe
    depends_on:
      - minio
    environment:
      CANTALOUPE_HTTP_ENABLED: "true"
      CANTALOUPE_HTTP_HOST: "0.0.0.0"
      CANTALOUPE_HTTP_PORT: "8182"
      CANTALOUPE_HTTPS_ENABLED: "false"
      CANTALOUPE_ENDPOINT_IIIF_3_ENABLED: "true"
      CANTALOUPE_ENDPOINT_IIIF_2_ENABLED: "true"
      CANTALOUPE_ENDPOINT_ADMIN_ENABLED: "false"
      CANTALOUPE_ENDPOINT_API_ENABLED: "false"
      CANTALOUPE_ENDPOINT_HEALTH_ENABLED: "true"
      # behind the proxy: the ids in info.json must be the PUBLIC urls, or every
      # viewer that follows them lands on a host it cannot reach
      CANTALOUPE_BASE_URI: "https://{{ server_name }}/iiif"
      CANTALOUPE_SOURCE_STATIC: "S3Source"
      CANTALOUPE_S3SOURCE_ENDPOINT: "http://minio:{{ minio_api_port }}"
      CANTALOUPE_S3SOURCE_ACCESS_KEY_ID: "{{ minio_root_user }}"
      CANTALOUPE_S3SOURCE_SECRET_KEY: "{{ minio_root_password }}"
      CANTALOUPE_S3SOURCE_REGION: "us-east-1"
      CANTALOUPE_S3SOURCE_LOOKUP_STRATEGY: "BasicLookupStrategy"
      CANTALOUPE_S3SOURCE_BASICLOOKUPSTRATEGY_BUCKET_NAME: "{{ minio_bucket }}"
      CANTALOUPE_S3SOURCE_BASICLOOKUPSTRATEGY_PATH_PREFIX: ""
      CANTALOUPE_S3SOURCE_BASICLOOKUPSTRATEGY_PATH_SUFFIX: ""
      CANTALOUPE_PROCESSOR_SELECTION_STRATEGY: "AutomaticSelectionStrategy"
      # A derivative cache belongs here (it is pure speed), but it must be
      # VERIFIED before it is switched on: with the filesystem cache enabled the
      # dev stack measured 200 responses with zero-byte bodies. Left off, with
      # the reason, rather than on and untested.
      CANTALOUPE_CACHE_SERVER_DERIVATIVE_ENABLED: "false"
    networks:
      - backend
    restart: always
{% endif %}
{% if minio_enabled | default(false) %}

  # =======================
  # OBJECT STORE (assets: models, orthophotos — referenced, not embedded)
  # =======================
  minio:
    image: {{ minio_image }}
    container_name: minio
    command: server /data --console-address ":{{ minio_console_port }}"
    environment:
      # From the inventory / Vault. The template FAILS here if they are not
      # provided, which is the intended behaviour: a default password would be
      # the same password on every deployment.
      MINIO_ROOT_USER: "{{ minio_root_user }}"
      MINIO_ROOT_PASSWORD: "{{ minio_root_password }}"
    ports:
      - "{{ minio_api_port }}:9000"
      - "{{ minio_console_port }}:{{ minio_console_port }}"
    volumes:
      - minio_data:/data
    networks:
      - backend
    restart: always
{% endif %}
# =======================
# NETWORK AND VOLUMES
# =======================
networks:
  backend:
    driver: bridge

volumes:
  couchdb_data:
  couchdb_config:
  keycloak_data:
{% if em_server_enabled | default(false) %}
  em_data:      # room documents — study data, include it in the backups
{% endif %}
{% if em_catalog_enabled | default(false) %}
  em_catalog_data:   # the SQLite index when CouchDB is off — DERIVED, so losing
                     # it costs one POST /catalog/reindex, not a study
{% endif %}
{% if minio_enabled | default(false) %}
  minio_data:   # the assets themselves, addressed by their own digest
{% endif %}
